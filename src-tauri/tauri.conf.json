{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Dock",
  "version": "0.3.0",
  "identifier": "app.aidock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Dock",
        "width": 58,
        "height": 300,
        "minWidth": 58,
        "minHeight": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": false,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.ico",
      "tooltip": "AI Dock"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": null,
      "nsis": null
    }
  }
}
